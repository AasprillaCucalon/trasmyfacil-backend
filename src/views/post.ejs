<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> | TrasmyFácil</title>
  <meta name="description" content="<%= post.content.substring(0, 160).replace(/"/g, '&quot;') %>">
  
  <!-- Open Graph -->
  <meta property="og:title" content="<%= post.title %>">
  <meta property="og:description" content="<%= post.content.substring(0, 160).replace(/"/g, '&quot;') %>">
  <meta property="og:url" content="<%= backendUrl %>/informacion/<%= post._id %>">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="TrasmyFácil">
  
  <% 
    // Función para convertir URLs relativas a absolutas usando backendUrl
    function toAbsoluteUrl(url) {
      if (!url) return '';
      if (url.startsWith('http://') || url.startsWith('https://')) return url;
      if (url.startsWith('/')) return backendUrl + url;
      return backendUrl + '/' + url;
    }
    
    // Imagen por defecto (usamos la URL pública del frontend para evitar problemas de acceso)
    const defaultImageUrl = 'https://trasmyfacil.netlify.app/assets/logo_web.png';
    let imageUrl = defaultImageUrl;
    let videoUrl = '';
    let videoType = '';
    
    if (post.mediaUrl && post.mediaType === 'image') {
      imageUrl = toAbsoluteUrl(post.mediaUrl);
    } else if (post.mediaUrl && (post.mediaType === 'video' || post.mediaType === 'reel')) {
      // Para video, mantenemos la imagen por defecto (o podrías extraer una miniatura si la tuvieras)
      imageUrl = defaultImageUrl;
      videoUrl = toAbsoluteUrl(post.mediaUrl);
      // Determinar tipo de video
      if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
        videoType = 'text/html';
      } else {
        videoType = 'video/mp4';
      }
    }
  %>
  
  <!-- Imagen (siempre presente, ya sea la del post, una miniatura de video o la por defecto) -->
  <meta property="og:image" content="<%= imageUrl %>">
  <meta property="og:image:secure_url" content="<%= imageUrl %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  
  <!-- Video (solo si hay video o reel) -->
  <% if (videoUrl) { %>
    <meta property="og:video" content="<%= videoUrl %>">
    <meta property="og:video:secure_url" content="<%= videoUrl %>">
    <meta property="og:video:type" content="<%= videoType %>">
    <meta property="og:video:width" content="1280">
    <meta property="og:video:height" content="720">
  <% } %>
  
  <!-- Twitter Card (mejora la vista previa en redes) -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= post.title %>">
  <meta name="twitter:description" content="<%= post.content.substring(0, 160).replace(/"/g, '&quot;') %>">
  <meta name="twitter:image" content="<%= imageUrl %>">
</head>
<body>
  <div style="text-align: center; padding: 40px; font-family: sans-serif;">
    <h1><%= post.title %></h1>
    <p><%= post.content %></p>
    <p>Si no eres redirigido automáticamente, <a href="<%= frontendUrl %>/informacion/<%= post._id %>">haz clic aquí</a>.</p>
  </div>
</body>
</html>
